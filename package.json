{
  "name": "code-clicker",
  "type": "module",
  "version": "1.0.0",
  "description": "Code Clicker game",
  "author": {
    "name": "Jimmy S",
    "email": "savarynj@gmail.com"
  },
  "main": "main.js",
  "build": {
    "appId": "game.savaryn.me",
    "mac": {
      "target": "zip",
      "category": "public.add-category.games",
      "icon": "assets/no_border.jpg"
    },
    "win": {
      "target": [
        "portable",
        "zip"
      ],
      "icon": "assets/no_border.jpg"
    },
    "linux": {
      "target": "zip",
      "icon": "assets/no_border.jpg"
    },
    "portable": {
      "unicode": false,
      "artifactName": "game.exe"
    },
    "files": [
      "**/*",
      "!node_modules/.cache/**/*"
    ]
  },
    "devDependencies": {
    "@types/bun": "^1.3.14",
    "electron": "42.1.0",
    "electron-builder": "^26.8.1",
    "icon-gen": "^5.0.0"
  },
  "scripts": {
    "start": "electron .",
    "build-icons": "mkdir icons; bunx icon-gen -i assets/no_border.jpg -o icons",
    "build:mac": "bun run build-icons && bunx electron-builder --mac --universal -c.mac.identity=null --publish never",
    "build:win": "bun run build-icons && bunx electron-builder --win",
    "build:linux": "bun run build-icons && bunx electron-builder --linux"
  }
}
